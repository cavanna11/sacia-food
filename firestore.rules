rules_version = '2';

// Aislamiento multi-tenant estricto.
//
// Principios:
//  1. Cada dato vive bajo tenants/{tenantId}/... y solo lo accede quien
//     tiene ese tenantId en sus custom claims. Ninguna regla permite
//     cruzar tenants.
//  2. Lo sensible (crear pedidos, pagos, provisioning, cambio de plan)
//     entra SOLO por Cloud Functions con el Admin SDK, que no pasa por
//     estas reglas. Por eso acá esas escrituras están en `false`.
//  3. `list` de tenants está prohibido para clientes: nadie enumera
//     los comercios de la plataforma desde el navegador.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn() && request.auth.token.role == 'superadmin';
    }

    // El usuario pertenece a este tenant (claim estampado server-side).
    function belongsTo(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }

    function isStaff(tenantId) {
      return belongsTo(tenantId)
        && request.auth.token.role in ['owner', 'staff', 'kitchen'];
    }

    match /tenants/{tenantId} {
      // El doc del tenant (branding, horarios) es público: el storefront
      // lo necesita antes de cualquier login. Solo `get`, nunca `list`.
      allow get: if true;
      allow list: if isSuperadmin();
      // Alta de tenants: solo Cloud Functions (provisioning).
      allow create, delete: if false;
      // El dueño puede editar su config operativa (horarios, pausa) y su
      // branding (nombre, colores, modo). Plan, subdominio, estado y
      // credenciales siguen siendo server-side (Cloud Functions).
      allow update: if belongsTo(tenantId)
        && request.auth.token.role == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['config', 'branding']);

      match /products/{productId} {
        // El menú es público (el cliente final lo ve sin cuenta).
        allow get, list: if true;
        // El catálogo lo administra el staff del propio tenant.
        allow write: if isStaff(tenantId);
      }

      match /orders/{orderId} {
        allow get, list: if isStaff(tenantId) || isSuperadmin();
        // Crear pedidos: solo Cloud Functions (anti-fraude, precios del server).
        allow create, delete: if false;
        // El staff opera el pedido (aceptar, avanzar estado, marcar cobrado)
        // pero NO puede tocar items, total ni datos del cliente.
        allow update: if isStaff(tenantId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'paymentStatus', 'updatedAt']);
      }

      match /customers/{customerId} {
        allow get, list: if isStaff(tenantId) || isSuperadmin();
        allow write: if false;
      }

      match /payments/{paymentId} {
        // Eventos de pago: el staff los ve (conciliación); escribe solo el
        // server (webhook / simulador de MercadoPago).
        allow get, list: if isStaff(tenantId) || isSuperadmin();
        allow write: if false;
      }

      match /members/{uid} {
        // Cada miembro del staff puede ver el listado de su propio equipo.
        allow get, list: if belongsTo(tenantId) || isSuperadmin();
        // Altas/bajas de usuarios: solo Cloud Functions (setean claims).
        allow write: if false;
      }

      match /blocklist/{phoneKey} {
        // Lista negra de teléfonos (anti-fraude capa 5): la gestiona el
        // staff del tenant. El cliente final jamás la ve.
        allow read, write: if isStaff(tenantId) || isSuperadmin();
      }

      match /tracking/{orderId} {
        // Estado público del pedido, sin PII (lo publica un trigger).
        // Solo `get` con el ID exacto (inadivinable); nunca listar.
        allow get: if true;
        allow list: if false;
        allow write: if false;
      }

      match /private/{docId} {
        // Secretos del tenant (credenciales MP tokenizadas, etc.):
        // jamás accesibles desde un cliente.
        allow read, write: if false;
      }
    }

    // Colecciones de plataforma (suscripciones, blocklist, auditoría):
    // solo server-side.
    match /platform/{document=**} {
      allow read, write: if false;
    }

    // Default deny explícito para todo lo no contemplado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
