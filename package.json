{
  "name": "gestion-pedidos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions --project demo-gestion-pedidos",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gestion-pedidos \"vitest run tests/rules\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.22.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
