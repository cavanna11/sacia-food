# ── Copiá este archivo a .env.local para desarrollo ─────────────────────────
# En local todo corre contra los emuladores de Firebase: no hacen falta
# credenciales reales. Cuando exista el proyecto Firebase de producción,
# estos valores se reemplazan por los reales (y en Vercel van como env vars).

# Dominio(s) raíz de la plataforma. Los subdominios de esto son tenants.
# En prod: "midominio.com" (y el wildcard *.midominio.com apuntado en Vercel).
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Config del SDK cliente de Firebase (con emuladores alcanzan valores fake).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gestion-pedidos
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gestion-pedidos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Usar emuladores locales (Auth 9099, Firestore 8080).
NEXT_PUBLIC_USE_EMULATORS=true

# El Admin SDK (server) detecta los emuladores por estas variables.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Solo producción ──────────────────────────────────────────────────────────
# JSON completo del service account (una sola línea) para el Admin SDK.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
